# Single source for every pinned tool and image version.
#
# This file is sourced by scripts/bootstrap-shell.sh, the toolbox build,
# and CI. Keep values as simple shell assignments. The `# renovate:`
# annotation above each version tells the generic manager in renovate.json
# where updates come from; a new entry only needs its annotation here, not a
# new manager.
# renovate: datasource=github-releases depName=opentofu/opentofu
OPENTOFU_VERSION=1.12.6
# renovate: datasource=github-releases depName=terraform-linters/tflint
TFLINT_VERSION=0.64.0
# renovate: datasource=github-releases depName=koalaman/shellcheck
SHELLCHECK_VERSION=0.11.0
# renovate: datasource=github-releases depName=mvdan/sh
SHFMT_VERSION=3.13.1
# renovate: datasource=github-releases depName=astral-sh/ruff
RUFF_VERSION=0.16.3
# renovate: datasource=github-releases depName=rhysd/actionlint
ACTIONLINT_VERSION=1.7.12
# renovate: datasource=github-releases depName=astral-sh/uv
UV_VERSION=0.12.5
# renovate: datasource=pypi depName=pytest
PYTEST_VERSION=9.1.1
# renovate: datasource=pypi depName=pytest-cov
PYTEST_COV_VERSION=7.1.0
# renovate: datasource=pypi depName=coverage
COVERAGE_VERSION=7.15.4
# renovate: datasource=pypi depName=boto3
BOTO3_VERSION=1.43.74
# renovate: datasource=pypi depName=moto
MOTO_VERSION=5.2.2

# Local Lambda-runtime emulation (scripts/dev-stack.sh).
# renovate: datasource=docker depName=amazon/dynamodb-local
DYNAMODB_LOCAL_VERSION=3.3.1

# The browser that renders the README screenshot (scripts/screenshot.sh).
# A rendering engine is the one tool this repository cannot install from a
# checksummed release archive, so it stays in its own container.
# renovate: datasource=docker depName=zenika/alpine-chrome
ALPINE_CHROME_VERSION=124

# The Lambda Python version: one definition feeding the OpenTofu `runtime`
# string, the local-emulation image tag, and ruff's target-version. The
# mirrors are asserted by scripts/check-cross-layer.py.
# renovate: datasource=docker depName=public.ecr.aws/lambda/python
LAMBDA_PYTHON_VERSION=3.14
